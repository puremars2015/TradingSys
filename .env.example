# Flask
SECRET_KEY=your-secret-key-here
DEBUG=false

# Trading — webhook 送的是純數值陣列，不帶商品代號，固定用這個標的
DEFAULT_SYMBOL=TXF1!

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_USER_ID=your-user-id-here

# OpenRouter (LLM)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=minimax/MiniMax-M2.7

# Agnes AI (LLM) — 另一個 LLM provider
AGNES_API_KEY=your-agnes-api-key-here
AGNES_API_URL=https://apihub.agnes-ai.com/v1/chat/completions
AGNES_MODEL=mini-max-m2.5

# LLM Provider: 'openrouter' or 'agnes'
LLM_PROVIDER=openrouter

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here

# LINE Bot
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret
